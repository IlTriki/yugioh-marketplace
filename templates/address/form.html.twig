{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="max-w-md mx-auto">
        <h1 class="text-2xl font-bold mb-6">{{ title }}</h1>

        {{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}
            <div>
                {{ form_label(form.street, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.street, {'attr': {'class': 'w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary'}}) }}
                {{ form_errors(form.street) }}
            </div>

            <div>
                {{ form_label(form.postalCode, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.postalCode, {'attr': {'class': 'w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary'}}) }}
                {{ form_errors(form.postalCode) }}
            </div>

            <div>
                {{ form_label(form.city, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.city, {'attr': {'class': 'w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary'}}) }}
                {{ form_errors(form.city) }}
            </div>

            <div>
                {{ form_label(form.country, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(form.country, {'attr': {'class': 'w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary'}}) }}
                {{ form_errors(form.country) }}
            </div>

            <div class="flex justify-end space-x-4">
                <a href="{{ isFromProfile ? path('profile_addresses') : path('checkout') }}" 
                   class="px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50">
                    {{ 'Annuler'|trans }}
                </a>
                <button type="submit" class="px-4 py-2 bg-primary text-white rounded-md hover:bg-primary-dark">
                    {{ 'Enregistrer'|trans }}
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %} 