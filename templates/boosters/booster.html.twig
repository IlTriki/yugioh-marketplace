<li class="max-sm:w-64 max-sm:mx-auto">
    <a href="#" class="group block">
        <img
            src="{{ booster.images|first.url|default('https://via.placeholder.com/350x450') }}"
            alt=""
            class="h-auto w-full object-contain transition duration-500 group-hover:scale-105"
        />

        <div class="relative pt-3">
            <h3 class="text-xl text-gray-700 group-hover:underline group-hover:underline-offset-4">
            {{ booster.name }}
            </h3>

            <p class="mt-2">    
            <span class="tracking-wider text-gray-900"> {{ booster.price | number_format(2, '.', ',') }} € </span>
            </p>
        </div>
    </a>
</li>