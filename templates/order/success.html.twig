{% extends 'base.html.twig' %}

{% block title %}{{ 'Commande confirmée'|trans }}{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-16">
    <div class="max-w-2xl mx-auto text-center">
        <div class="mb-8">
            <svg class="mx-auto h-16 w-16 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
        </div>
        
        <h1 class="text-3xl font-bold mb-4">{{ 'Merci pour votre commande!'|trans }}</h1>
        <p class="text-gray-600 mb-8">{{ 'Votre numéro de commande est:'|trans }} <span class="font-semibold">{{ order.reference }}</span></p>
        
        <div class="space-y-4">
            <p>{{ 'Un email de confirmation vous a été envoyé.'|trans }}</p>
            <p>{{ 'Vous pouvez suivre votre commande dans votre espace client.'|trans }}</p>
        </div>

        <div class="mt-12">
            <a href="{{ path('browse') }}" 
               class="bg-primary text-white px-6 py-3 rounded-lg hover:bg-primary-dark transition-colors">
                {{ 'Continuer mes achats'|trans }}
            </a>
        </div>
    </div>
</div>
{% endblock %} 