{% extends 'base.html.twig' %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('styles/product_pages.css') }}">
{% endblock %}

{% block javascripts %}
	{{ parent() }}
{% endblock %}

{% block title %}DuelistDepot
{% endblock %}

{% block body %}
	<section>
		<div class="mx-auto max-w-screen-2xl py-8 sm:py-12">
			<header class="flex flex-row content-end justify-between">
				<h2 class="text-xl font-bold text-gray-900 sm:text-3xl">{{ "Decouvre nos cartes"|trans }}</h2>
				<div>
					<form method="get" id="searchForm" action="{{ path(searchPath) }}" data-controller="product-search" class="flex flex-col gap-4">
						<div class="flex px-4 rounded-md border-2 border-blue-500 overflow-hidden max-w-md font-[sans-serif]">
							<svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 192.904 192.904" width="16px" class="fill-gray-600 mr-3 rotate-90">
								<path d="m190.707 180.101-47.078-47.077c11.702-14.072 18.752-32.142 18.752-51.831C162.381 36.423 125.959 0 81.191 0 36.422 0 0 36.423 0 81.193c0 44.767 36.422 81.187 81.191 81.187 19.688 0 37.759-7.049 51.831-18.751l47.079 47.078a7.474 7.474 0 0 0 5.303 2.197 7.498 7.498 0 0 0 5.303-12.803zM15 81.193C15 44.694 44.693 15 81.191 15c36.497 0 66.189 29.694 66.189 66.193 0 36.496-29.692 66.187-66.189 66.187C44.693 147.38 15 117.689 15 81.193z"></path>
							</svg>
							<input type="text" name="name" placeholder="{{ "Cherchez quelquechose"|trans }}..." value="{{ searchTerm|default('') }}" class="w-full outline-none bg-transparent text-gray-600 text-sm border-none border-transparent"/>
						</div>
					</form>
				</div>
			</header>

			<details class="mt-8 block lg:hidden product-detail-filters">
				<summary class="flex cursor-pointer items-center gap-2 border-b border-gray-400 pb-1 text-gray-900 transition hover:border-gray-600 w-fit">
					<span class="text-sm font-medium">
						{{ "Filtres"|trans }}
						& {{ "Triage"|trans }}
					</span>

					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 transition-transform duration-500">
						<path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
					</svg>
				</summary>
				<br>
				<div>
					<label for="SortByPhone" class="block text-xs font-medium text-gray-700">
						{{ "Trier par"|trans }}
					</label>

					<select id="SortByPhone" class="mt-1 rounded border-gray-300 text-sm SortBy">
						<option value="Name, DESC">{{ "Nom"|trans }}, DESC</option>
						<option value="Name, ASC">{{ "Nom"|trans }}, ASC</option>
						<option value="Price, DESC">{{ "Prix"|trans }}, DESC</option>
						<option value="Price, ASC">{{ "Prix"|trans }}, ASC</option>
					</select>
				</div>

				<div>
					<p class="block text-xs font-medium text-gray-700">{{ "Filtres"|trans }}</p>

					<div class="mt-1 space-y-2">
						<details class="overflow-hidden rounded border border-gray-300 [&_summary::-webkit-details-marker]:hidden">
							<summary class="flex cursor-pointer items-center justify-between gap-2 p-2 text-gray-900 transition">
								<span class="text-sm font-medium">
									{{ "Disponibilité"|trans }}
								</span>

								<span class="transition group-open:-rotate-180">
									<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
										<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
									</svg>
								</span>
							</summary>

							<div class="border-t border-gray-200 bg-white">
								<header class="flex items-center justify-between p-2">
									<span class="text-sm text-gray-700">
									</span>

									<button type="button" class="text-sm text-gray-900 underline underline-offset-4 availability-reset ">
										Reset
									</button>
								</header>

								<ul class="space-y-1 border-t border-gray-200 p-2">
									<li>
										<label for="FilterInStockPhone" class="inline-flex items-center gap-2">
											<input type="checkbox" id="FilterInStockPhone" class="size-5 rounded border-gray-300 FilterInStock"/>

											<span class="text-sm font-medium text-gray-700">
												{{ 'En stock'|trans }}
											</span>
										</label>
									</li>

									<li>
										<label for="FilterPreOrderPhone" class="inline-flex items-center gap-2">
											<input type="checkbox" id="FilterPreOrderPhone" class="size-5 rounded border-gray-300 FilterPreOrder"/>

											<span class="text-sm font-medium text-gray-700">
												{{ 'Precommande'|trans }}
											</span>
										</label>
									</li>

									<li>
										<label for="FilterOutOfStockPhone" class="inline-flex items-center gap-2">
											<input type="checkbox" id="FilterOutOfStockPhone" class="size-5 rounded border-gray-300 FilterOutOfStock"/>

											<span class="text-sm font-medium text-gray-700">
												{{ 'En rupture'|trans }}
											</span>
										</label>
									</li>
								</ul>
							</div>
						</details>

						<details class="overflow-hidden rounded border border-gray-300 [&_summary::-webkit-details-marker]:hidden">
							<summary class="flex cursor-pointer items-center justify-between gap-2 p-2 text-gray-900 transition">
								<span class="text-sm font-medium">
									Price
								</span>

								<span class="transition group-open:-rotate-180">
									<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
										<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
									</svg>
								</span>
							</summary>

							<div class="border-t border-gray-200 bg-white">
								<header class="flex items-center justify-between p-2">
									<span class="text-sm text-gray-700">
									</span>

									<button type="button" class="text-sm text-gray-900 underline underline-offset-4 price-reset">
										Reset
									</button>
								</header>

								<div class="border-t border-gray-200 p-2">
									<div class="flex justify-between gap-4">
										<label for="FilterPriceFromPhone" class="flex items-center gap-2">
											<input type="number" id="FilterPriceFromPhone" placeholder="{{ 'De'|trans }}" class="w-full rounded-md border-gray-200 shadow-sm sm:text-sm FilterPriceFrom"/>

											<span class="text-sm text-gray-600">€</span>
										</label>

										<label for="FilterPriceToPhone" class="flex items-center gap-2">
											<input type="number" id="FilterPriceToPhone" placeholder="{{ 'À'|trans }}" class="w-full rounded-md border-gray-200 shadow-sm sm:text-sm FilterPriceTo"/>

											<span class="text-sm text-gray-600">€</span>
										</label>
									</div>
								</div>
							</div>
						</details>
					</div>
				</div>
			</details>

			<div class="mt-4 lg:mt-8 lg:grid lg:grid-cols-4 lg:items-start lg:gap-8">
				<div class="hidden space-y-4 lg:block">
					<div>
						<label for="SortBy" class="block text-xs font-medium text-gray-700">
							{{ "Trier par"|trans }}
						</label>

						<select id="SortBy" class="mt-1 rounded border-gray-300 text-sm SortBy">
							<option value="Name, DESC">{{ "Nom"|trans }}, DESC</option>
							<option value="Name, ASC">{{ "Nom"|trans }}, ASC</option>
							<option value="Price, DESC">{{ "Prix"|trans }}, DESC</option>
							<option value="Price, ASC">{{ "Prix"|trans }}, ASC</option>
						</select>
					</div>

					<div>
						<p class="block text-xs font-medium text-gray-700">{{ "Filtres"|trans }}</p>

						<div class="mt-1 space-y-2">
							<details class="overflow-hidden rounded border border-gray-300 [&_summary::-webkit-details-marker]:hidden">
								<summary class="flex cursor-pointer items-center justify-between gap-2 p-2 text-gray-900 transition">
									<span class="text-sm font-medium">
										{{ "Disponibilité"|trans }}
									</span>

									<span class="transition group-open:-rotate-180">
										<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
											<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
										</svg>
									</span>
								</summary>

								<div class="border-t border-gray-200 bg-white">
									<header class="flex items-center justify-between p-2">
										<span class="text-sm text-gray-700">
										</span>

										<button type="reset" class="text-sm text-gray-900 underline underline-offset-4 availability-reset">
											Reset
										</button>
									</header>

									<ul class="space-y-1 border-t border-gray-200 p-2">
										<li>
											<label for="FilterInStock" class="inline-flex items-center gap-2">
												<input type="checkbox" id="FilterInStock" class="size-5 rounded border-gray-300 FilterInStock"/>

												<span class="text-sm font-medium text-gray-700">
													{{ 'En stock'|trans }}
												</span>
											</label>
										</li>

										<li>
											<label for="FilterPreOrder" class="inline-flex items-center gap-2">
												<input type="checkbox" id="FilterPreOrder" class="size-5 rounded border-gray-300 FilterPreOrder"/>

												<span class="text-sm font-medium text-gray-700">
													{{ 'Precommande'|trans }}
												</span>
											</label>
										</li>

										<li>
											<label for="FilterOutOfStock" class="inline-flex items-center gap-2">
												<input type="checkbox" id="FilterOutOfStock" class="size-5 rounded border-gray-300 FilterOutOfStock"/>

												<span class="text-sm font-medium text-gray-700">
													{{ 'En rupture'|trans }}
												</span>
											</label>
										</li>
									</ul>
								</div>
							</details>

							<details class="overflow-hidden rounded border border-gray-300 [&_summary::-webkit-details-marker]:hidden">
								<summary class="flex cursor-pointer items-center justify-between gap-2 p-2 text-gray-900 transition">
									<span class="text-sm font-medium">
										Price
									</span>

									<span class="transition group-open:-rotate-180">
										<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
											<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
										</svg>
									</span>
								</summary>

								<div class="border-t border-gray-200 bg-white">
									<header class="flex items-center justify-between p-2">
										<span class="text-sm text-gray-700">
										</span>

										<button type="reset" class="text-sm text-gray-900 underline underline-offset-4 price-reset">
											Reset
										</button>
									</header>

									<div class="border-t border-gray-200 p-2">
										<div class="flex justify-between gap-4">
											<label for="FilterPriceFrom" class="flex items-center gap-2">
												<input type="number" id="FilterPriceFrom" placeholder="{{ 'De'|trans }}" class="w-full rounded-md border-gray-200 shadow-sm sm:text-sm FilterPriceFrom"/>

												<span class="text-sm text-gray-600">€</span>
											</label>

											<label for="FilterPriceTo" class="flex items-center gap-2">
												<input type="number" id="FilterPriceTo" placeholder="{{ 'À'|trans }}" class="w-full rounded-md border-gray-200 shadow-sm sm:text-sm FilterPriceTo"/>

												<span class="text-sm text-gray-600">€</span>
											</label>
										</div>
									</div>
								</div>
							</details>
						</div>
					</div>
				</div>


				<div class="lg:col-span-3">
					<ul class="mt-8 grid gap-18 sm:grid-cols-2 lg:grid-cols-4" id="cards-list">
						{% for product in products %}
							<li class="max-sm:w-64 max-sm:mx-auto" data-name="{{ product.name }}" data-price="{{ product.price }}">
								<a href="#" class="group block">
									<img src="{{ product.images|first.url|default('https://via.placeholder.com/350x450') }}" alt="" class="h-auto w-full object-contain transition duration-500 group-hover:scale-105"/>

									<div class="relative pt-3">
										<h3 class="text-xl text-gray-700 group-hover:underline group-hover:underline-offset-4 card-name" id="card-name">
											{{ product.name }}
										</h3>

										<p class="mt-2">
											<span class="tracking-wider text-gray-900 card-price" id="card-price">
												{{ product.price | number_format(2, '.', ',') }}
												€
											</span>
										</p>
									</div>
								</a>
							</li>
						{% else %}
							<p>{{ errorMessage | trans }}</p>
						{% endfor %}
					</ul>
				</div>
			</div>
		</div>
	</section>
	<div class="m-auto w-fit bg-primary">
		{{ knp_pagination_render(products) }}
	</div>
{% endblock %}