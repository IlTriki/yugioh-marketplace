{% extends 'base.html.twig' %}

{% block title %}{{ 'Modifier mon profil'|trans }}{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
        <div class="bg-white rounded-lg shadow-lg overflow-hidden">
            <div class="bg-gray-50 px-6 py-4 border-b">
                <div class="flex space-x-4">
                    <a href="{{ path('profile') }}" 
                       class="px-3 py-2 rounded-md text-sm font-medium bg-primary text-white">
                        {{ 'Profil'|trans }}
                    </a>
                    <a href="{{ path('profile_orders') }}" 
                       class="px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-primary">
                        {{ 'Commandes'|trans }}
                    </a>
                    <a href="{{ path('profile_addresses') }}" 
                       class="px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-primary">
                        {{ 'Adresses'|trans }}
                    </a>
                </div>
            </div>

            <div class="p-6">
                <h1 class="text-2xl font-bold mb-6">{{ 'Modifier mon profil'|trans }}</h1>

                {{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}
                    <div>
                        {{ form_label(form.username, 'Nom d\'utilisateur'|trans, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                        {{ form_widget(form.username, {'attr': {'class': 'w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary'}}) }}
                        {{ form_errors(form.username) }}
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">{{ 'Email'|trans }}</label>
                        <div class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-50 text-gray-500">
                            {{ app.user.email }}
                        </div>
                    </div>

                    <div>
                        {{ form_label(form.firstName, 'Prénom'|trans, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                        {{ form_widget(form.firstName, {'attr': {'class': 'w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary'}}) }}
                        {{ form_errors(form.firstName) }}
                    </div>

                    <div>
                        {{ form_label(form.lastName, 'Nom'|trans, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                        {{ form_widget(form.lastName, {'attr': {'class': 'w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary'}}) }}
                        {{ form_errors(form.lastName) }}
                    </div>

                    <div class="flex justify-end space-x-4 pt-4">
                        <a href="{{ path('profile') }}" 
                           class="px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50">
                            {{ 'Annuler'|trans }}
                        </a>
                        <button type="submit" 
                                class="px-4 py-2 bg-primary text-white rounded-md hover:bg-primary-dark">
                            {{ 'Enregistrer'|trans }}
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %} 