{% extends 'base.html.twig' %}

{% block title %}{{ 'Mes commandes'|trans }}{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
        <div class="bg-white rounded-lg shadow-lg overflow-hidden">
            {# Profile Navigation - same as index.html.twig #}
            <div class="bg-gray-50 px-6 py-4 border-b">
                <div class="flex space-x-4">
                    <a href="{{ path('profile') }}" 
                       class="px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-primary">
                        {{ 'Profil'|trans }}
                    </a>
                    <a href="{{ path('profile_orders') }}" 
                       class="px-3 py-2 rounded-md text-sm font-medium bg-primary text-white">
                        {{ 'Commandes'|trans }}
                    </a>
                    <a href="{{ path('profile_addresses') }}" 
                       class="px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-primary">
                        {{ 'Adresses'|trans }}
                    </a>
                </div>
            </div>

            {# Orders List #}
            <div class="p-6">
                <h1 class="text-2xl font-bold mb-6">{{ 'Mes commandes'|trans }}</h1>

                {% if orders|length > 0 %}
                    <div class="space-y-4">
                        {% for order in orders %}
                            <div class="border rounded-lg p-4">
                                <div class="flex justify-between items-start mb-4">
                                    <div>
                                        <p class="font-medium">{{ 'Commande'|trans }} #{{ order.reference }}</p>
                                        <p class="text-sm text-gray-500">{{ order.createdAt|date('d/m/Y H:i') }}</p>
                                    </div>
                                    <span class="px-2 py-1 text-sm rounded-full 
                                        {% if order.status == 'SENDING' %}bg-blue-100 text-blue-800
                                        {% elseif order.status == 'DELIVERED' %}bg-green-100 text-green-800
                                        {% else %}bg-gray-100 text-gray-800{% endif %}">
                                        {{ order.status.value|trans }}
                                    </span>
                                </div>

                                <div class="space-y-2">
                                    {% for item in order.orderItems %}
                                        <div class="flex justify-between items-center text-sm">
                                            <span>{{ item.product.name }} × {{ item.quantity }}</span>
                                            <span>{{ item.productPrice * item.quantity }} €</span>
                                        </div>
                                    {% endfor %}
                                </div>

                                <div class="mt-4 pt-4 border-t flex justify-between items-center">
                                    <span class="font-medium">{{ 'Total'|trans }}</span>
                                    <span class="font-medium">{{ order.total|number_format(2, ',', '.') }} €</span>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-center text-gray-500">{{ 'Aucune commande'|trans }}</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %} 