{% extends 'base.html.twig' %}

{% block title %}{{ 'Mes adresses'|trans }}{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
        <div class="bg-white rounded-lg shadow-lg overflow-hidden">
            {# Profile Navigation - same as other templates #}
            <div class="bg-gray-50 px-6 py-4 border-b">
                <div class="flex space-x-4">
                    <a href="{{ path('profile') }}" 
                       class="px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-primary">
                        {{ 'Profil'|trans }}
                    </a>
                    <a href="{{ path('profile_orders') }}" 
                       class="px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-primary">
                        {{ 'Commandes'|trans }}
                    </a>
                    <a href="{{ path('profile_addresses') }}" 
                       class="px-3 py-2 rounded-md text-sm font-medium bg-primary text-white">
                        {{ 'Adresses'|trans }}
                    </a>
                </div>
            </div>

            {# Addresses List #}
            <div class="p-6">
                <div class="flex justify-between items-center mb-6">
                    <h1 class="text-2xl font-bold">{{ 'Mes adresses'|trans }}</h1>
                    <a href="{{ path('address_new', {isFromProfile: true}) }}" 
                       class="bg-primary text-white px-4 py-2 rounded-lg hover:bg-primary-dark">
                        {{ 'Ajouter une adresse'|trans }}
                    </a>
                </div>

                {% if addresses|length > 0 %}
                    <div class="grid gap-4 md:grid-cols-2">
                        {% for address in addresses %}
                            <div class="border rounded-lg p-4">
                                <p>{{ address.street }}</p>
                                <p>{{ address.postalCode }} {{ address.city }}</p>
                                <p>{{ address.country }}</p>
                                <div class="mt-4">
                                    <a href="{{ path('address_edit', {id: address.id, isFromProfile: true}) }}" 
                                       class="text-primary hover:text-primary-dark">
                                        {{ 'Modifier'|trans }}
                                    </a>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-center text-gray-500">{{ 'Aucune adresse'|trans }}</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %} 