{% extends 'base.html.twig' %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('styles/home.css') }}">
{% endblock %}

{% block title %}DuelistDepot
{% endblock %}

{% block body %}
	<section class="hero-container">
		<div class="shine-text text-6xl md:text-8xl">
			<span>D</span>
			<span>u</span>
			<span>e</span>
			<span>l</span>
			<span>i</span>
			<span>s</span>
			<span>t</span>
			<span></span>
			<span>D</span>
			<span>e</span>
			<span>p</span>
			<span>o</span>
