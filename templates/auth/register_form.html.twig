{% extends 'auth/base_auth.html.twig' %}

{% block body %}
    <h1 class="h3 mb-3 font-weight-normal">{{ 'Veuillez vous inscrire'|trans }}</h1>
    
    {{ form_start(registrationForm, {'attr': {'class': 'space-y-6'}}) }}
        {% if form_errors(registrationForm) %}
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert">
                {{ form_errors(registrationForm) }}
            </div>
        {% endif %}

        <div>
            {{ form_label(registrationForm.email, 'Email'|trans, {'label_attr': {'class': 'block text-sm font-medium leading-6 text-gray-900'}}) }}
            <div class="mt-2">
                {{ form_widget(registrationForm.email, {
                    'attr': {
                        'class': 'block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6'
                    }
                }) }}
            </div>
        </div>

        <div>
            {{ form_label(registrationForm.firstName, 'Prenom'|trans, {'label_attr': {'class': 'block text-sm font-medium leading-6 text-gray-900'}}) }}
            <div class="mt-2">
                {{ form_widget(registrationForm.firstName, {
                    'attr': {
                        'class': 'block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6'
                    }
                }) }}
            </div>
        </div>

        <div>
            {{ form_label(registrationForm.lastName, 'Nom de famille'|trans, {'label_attr': {'class': 'block text-sm font-medium leading-6 text-gray-900'}}) }}
            <div class="mt-2">
                {{ form_widget(registrationForm.lastName, {
                    'attr': {
                        'class': 'block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6'
                    }
                }) }}
            </div>
        </div>

        <div>
            {{ form_label(registrationForm.username, 'Nom d\'utilisateur'|trans, {'label_attr': {'class': 'block text-sm font-medium leading-6 text-gray-900'}}) }}
            <div class="mt-2">
                {{ form_widget(registrationForm.username, {
                    'attr': {
                        'class': 'block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6'
                    }
                }) }}
            </div>
        </div>

        <div>
            {{ form_label(registrationForm.plainPassword, 'Mot de passe'|trans, {'label_attr': {'class': 'block text-sm font-medium leading-6 text-gray-900'}}) }}
            <div class="mt-2">
                {{ form_widget(registrationForm.plainPassword, {
                    'attr': {
                        'class': 'block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6'
                    }
                }) }}
            </div>
        </div>

        <div>
            <button type="submit" class="flex w-full justify-center rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-semibold leading-6 text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                {{ "S'inscrire"|trans }}
            </button>
        </div>
    {{ form_end(registrationForm) }}

    <p class="mt-10 text-center text-sm text-gray-500">
        {{ "Vous avez deja un compte?"|trans }}
        <a href="{{ path('login') }}" class="font-semibold leading-6 text-primary hover:text-indigo-500">
            {{ "Connectez vous maintenant"|trans }}
        </a>
    </p>
{% endblock %}