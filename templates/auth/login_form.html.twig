{% extends 'auth/base_auth.html.twig' %}

{% block body %}
    <form method="post" class="space-y-6" >
    <h1 class="h3 mb-3 font-weight-normal">{{ 'Veuillez vous connecter'|trans }}</h1>
    <div>
        <label for="inputEmail" class="block text-sm font-medium leading-6">{{ 'Email'|trans }}</label>
        <div class="mt-2">
            <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" autocomplete="email" required autofocus>
        </div>
    </div>

    <div>
        <div class="flex items-center justify-between">
            <label for="inputPassword" class="block text-sm font-medium leading-6">{{ 'Mot de passe'|trans }}</label>
            <div class="text-sm">
                <a href="#" class="font-semibold text-primary hover:text-indigo-500">{{ 'Mot de passe oublié?'|trans }}</a>
            </div>
        </div>
        <div class="mt-2">
            <input type="password" name="password" id="inputPassword" class="form-control block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" autocomplete="current-password" required>
        </div>
    </div>

    <input type="hidden" name="_csrf_token"
        value="{{ csrf_token('authenticate') }}"
    >

    {% if error %}
        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <div>
        <button class="btn btn-lg btn-primary flex w-full justify-center rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-semibold leading-6 text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" type="submit">
            {{ 'Se connecter'|trans }}
        </button>
    </div>
    </form>
    <p class="mt-10 text-center text-sm text-gray-500">
    {{ "Vous n'avez pas de compte?"|trans }}
    <a href="{{ path('register') }}" class="font-semibold leading-6 text-primary hover:text-indigo-500">{{ "Inscrivez vous maintenant"|trans }}</a>
    </p>
{% endblock %}