{% extends 'base.html.twig' %}

{% block title %}{{ 'Gestion des produits'|trans }}{% endblock %}

{% block body %}
	<div class="container mx-auto px-4 py-8">
		<div class="flex justify-between items-center mb-6">
			<h1 class="text-3xl font-bold">{{ 'Gestion des produits'|trans }}</h1>
			<a href="{{ path('admin_product_new') }}" class="bg-primary text-white px-4 py-2 rounded hover:bg-primary-dark">
				{{ 'Ajouter un produit'|trans }}
			</a>
		</div>

		{% for message in app.flashes('success') %}
			<div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
				{{ message }}
			</div>
		{% endfor %}

		{% for message in app.flashes('error') %}
			<div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
				{{ message }}
			</div>
		{% endfor %}

		<div class="bg-white shadow-md rounded-lg p-4 mb-6">
			<form method="get" class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4">
				<label class="block text-sm font-medium text-gray-700">
					{{ 'Rechercher'|trans }}
					<input type="text" name="name" value="{{ filters.name }}" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary sm:text-sm">
				</label>

				<label class="block text-sm font-medium text-gray-700">Category
					<select name="category" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary sm:text-sm">
						<option value="">{{ 'Toutes les catégories'|trans }}</option>
						{% for category in categories %}
							<option value="{{ category.name }}" {% if filters.category == category.name %} selected {% endif %}>
								{{ category.name }}
							</option>
						{% endfor %}
					</select>
				</label>

				<label class="block text-sm font-medium text-gray-700">Status
					<select name="status" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary sm:text-sm">
						<option value="">{{ 'Tous les statuts'|trans }}</option>
						{% for status in productStatuses %}
							<option value="{{ status.value }}" {% if filters.status == status.value %} selected {% endif %}>
								{{ status.value }}
							</option>
						{% endfor %}
					</select>
				</label>

				<label class="block text-sm font-medium text-gray-700">Price Range
					<div class="grid grid-cols-2 gap-2">
						<input type="number" name="minPrice" value="{{ filters.priceFrom }}" placeholder="Min" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary sm:text-sm">
						<input type="number" name="maxPrice" value="{{ filters.priceTo }}" placeholder="Max" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary sm:text-sm">
					</div>
				</label>

				<div class="md:col-span-3 lg:col-span-4 flex justify-end">
					<button type="submit" class="bg-primary text-white px-4 py-2 rounded hover:bg-primary-dark">
						{{ 'Appliquer les filtres'|trans }}
					</button>
				</div>
			</form>
		</div>

		<div class="bg-white shadow-md rounded-lg overflow-x-auto">
			<table class="min-w-full">
				<thead class="bg-gray-50">
					<tr>
						<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
							<a href="{{ path('admin_products', filters|merge({ 'sortField': 'p.name', 'sortDirection': filters.sortField == 'p.name' and filters.sortDirection == 'ASC' ? 'DESC' : 'ASC' })) }}">
								{{ 'Nom'|trans }}
								{% if filters.sortField == 'p.name' %}
									{{ filters.sortDirection == 'ASC' ? '↑' : '↓' }}
								{% endif %}
							</a>
						</th>
						<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
							<a href="{{ path('admin_products', filters|merge({ 'sortField': 'p.price', 'sortDirection': filters.sortField == 'p.price' and filters.sortDirection == 'ASC' ? 'DESC' : 'ASC' })) }}">
								{{ 'Prix'|trans }}
								{% if filters.sortField == 'p.price' %}
									{{ filters.sortDirection == 'ASC' ? '↑' : '↓' }}
								{% endif %}
							</a>
						</th>
						<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
							{{ 'Stock'|trans }}
						</th>
						<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
							{{ 'Statut'|trans }}
						</th>
						<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
							{{ 'Actions'|trans }}
						</th>
					</tr>
				</thead>
				<tbody class="bg-white divide-y divide-gray-200">
					{% for product in pagination %}
						<tr>
							<td class="px-6 py-4 whitespace-nowrap">{{ product.name }}</td>
							<td class="px-6 py-4 whitespace-nowrap">{{ product.price }}€</td>
							<td class="px-6 py-4 whitespace-nowrap">{{ product.stock }}</td>
							<td class="px-6 py-4 whitespace-nowrap">{{ product.status.value }}</td>
							<td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
								<a href="{{ path('admin_product_edit', {'id': product.id}) }}" class="text-indigo-600 hover:text-indigo-900 mr-4">
									{{ 'Editer'|trans }}
								</a>
								<form method="post" action="{{ path('admin_product_delete', {'id': product.id}) }}" class="inline" onsubmit="return confirm('{{ 'Voulez-vous vraiment supprimer ce produit ?'|trans }}');">
									<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
									<button type="submit" class="text-red-600 hover:text-red-900">
										{{ 'Supprimer'|trans }}
									</button>
								</form>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>

		<div class="mt-4 mx-auto w-fit bg-primary">
			{{ knp_pagination_render(pagination, '@KnpPaginator/Pagination/tailwindcss_pagination.html.twig') }}
		</div>
	</div>
{% endblock %}
